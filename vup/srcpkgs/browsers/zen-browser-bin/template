# Template file for 'zen-browser-bin'
pkgname=zen-browser-bin
version=1.21.8b
revision=1
archs="x86_64"
hostmakedepends="tar xz"
depends="gtk+3 libXt nss alsa-lib dbus-glib ffmpeg"
short_desc="Experience tranquillity while browsing the web (Precompiled binary)"
maintainer="baka <femboyloverxfutalover@gmail.com>"
license="MPL-2.0"
homepage="https://zen-browser.app"

distfiles="https://github.com/zen-browser/desktop/releases/download/1.21.8b/zen.linux-x86_64.tar.xz"
checksum=05a36657e4c9dbe700e54a2e3941f7af4656abbe330690aa74d8cf793af396f4

nostrip=yes
nodebug=yes

do_install() {
  vmkdir opt/zen-browser
  vcopy * opt/zen-browser
  vmkdir usr/bin
  ln -s /opt/zen-browser/zen "${DESTDIR}/usr/bin/zen"
  vmkdir usr/share/pixmaps
  ln -s /opt/zen-browser/browser/chrome/icons/default/default128.png "${DESTDIR}/usr/share/pixmaps/zen-browser.png"
  vinstall "${FILESDIR}/zen-browser.desktop" 644 usr/share/applications
}
